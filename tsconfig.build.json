{
    "compilerOptions": {
        // File Layout
        "rootDir": "./src",
        "outDir": "./dist",
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "strictPropertyInitialization": false
    },
    "exclude": [
        "node_modules",
        "dist",
        "test",
        "tests",
        "**/*.test.ts",
        "**/*.spec.ts",
        "oxfmt.config.ts"
    ]
}
